<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SukiUI.DataGrid</RootNamespace>
    <IsPackable>true</IsPackable>
    <Title>SukiUI.DataGrid</Title>
    <Description>SukiUI DataGrid theme resources for Avalonia UI applications.</Description>
    <PackageTags>avalonia;avaloniaui;ui;theme;datagrid;controls;styling;sukiui</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SukiUI\SukiUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Controls.DataGrid" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="**\*.axaml" />
  </ItemGroup>

</Project>
