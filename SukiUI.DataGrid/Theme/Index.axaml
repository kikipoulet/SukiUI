<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StyleInclude Source="avares://SukiUI.DataGrid/Theme/DataGridStyles.axaml" />

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Must stay after SukiUI's TextBox theme: DataGridCellTextBoxTheme is based on it. -->
