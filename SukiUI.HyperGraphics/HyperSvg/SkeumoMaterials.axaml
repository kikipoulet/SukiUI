<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="SukiUI.HyperGraphics.SkeumoMaterials">
    <!--
        Catalogue de materiaux Skeumo-Suki : le metal bleu-ardoise de SukiUI, le verre, le caoutchouc, les reflets. Un SVG les
        nomme par la forme var( tiret-tiret SkeumoXxx ) dans un attribut fill ou stroke (voir GUIDE.md) ; aucun controle n'a besoin de les declarer.
        Les cles "Dark" / "Light" changent avec le theme ; les autres sont communes aux deux.
        Un controle qui declare la meme cle dans ses propres ressources garde la priorite.
    -->

    <!-- ===== Communs aux deux themes ===== -->

    <!-- Aluminium brosse, reflets en diagonale -->
    <LinearGradientBrush x:Key="SkeumoAluminium" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#FFE8ECF2" />
        <GradientStop Offset="0.25" Color="#FFB9C1CE" />
        <GradientStop Offset="0.5" Color="#FFD9DEE7" />
        <GradientStop Offset="0.78" Color="#FF9AA4B4" />
        <GradientStop Offset="1" Color="#FF7C8799" />
    </LinearGradientBrush>
    <!-- Aluminium brosse, reflets a l'horizontale (supports, bagues) -->
    <LinearGradientBrush x:Key="SkeumoAluminiumH" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#FF8D99B1" />
        <GradientStop Offset="0.3" Color="#FFF1F4FA" />
        <GradientStop Offset="0.6" Color="#FF8590A6" />
        <GradientStop Offset="1" Color="#FF4A5468" />
    </LinearGradientBrush>
    <!-- Biseau : blanc en haut, ombre en bas ; se pose par-dessus une forme -->
    <LinearGradientBrush x:Key="SkeumoBevel" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#B3FFFFFF" />
        <GradientStop Offset="0.1" Color="#00FFFFFF" />
        <GradientStop Offset="0.9" Color="#00000000" />
        <GradientStop Offset="1" Color="#4D000000" />
    </LinearGradientBrush>
    <!-- Reflet de verre en diagonale ; se pose par-dessus -->
    <LinearGradientBrush x:Key="SkeumoGloss" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#33FFFFFF" />
        <GradientStop Offset="0.28" Color="#0AFFFFFF" />
        <GradientStop Offset="0.29" Color="#00FFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </LinearGradientBrush>
    <!-- Lustre d'un boitier, plus large que le reflet de verre ; se pose par-dessus -->
    <LinearGradientBrush x:Key="SkeumoSheen" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#38FFFFFF" />
        <GradientStop Offset="0.35" Color="#0AFFFFFF" />
        <GradientStop Offset="0.36" Color="#00FFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </LinearGradientBrush>
    <!-- Bague d'un objectif : clair en haut, sombre en bas -->
    <LinearGradientBrush x:Key="SkeumoRim" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FFE3E9F4" />
        <GradientStop Offset="0.5" Color="#FF5A6580" />
        <GradientStop Offset="1" Color="#FF2A3242" />
    </LinearGradientBrush>
    <!-- Dome de verre bleu (lentille, voyant) -->
    <RadialGradientBrush x:Key="SkeumoGlassDome" GradientOrigin="38%,35%">
        <GradientStop Offset="0" Color="#FFA9C2FF" />
        <GradientStop Offset="0.45" Color="#FF3D63C9" />
        <GradientStop Offset="1" Color="#FF0A1230" />
    </RadialGradientBrush>

    <ResourceDictionary.ThemeDictionaries>
        <!-- ===== Sombre ===== -->
        <ResourceDictionary x:Key="Dark">
            <!-- Boitier : aluminium anodise ardoise -->
            <LinearGradientBrush x:Key="SkeumoBody" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FF586278" />
                <GradientStop Offset="0.12" Color="#FF3B4558" />
                <GradientStop Offset="0.55" Color="#FF2A3242" />
                <GradientStop Offset="1" Color="#FF171C25" />
            </LinearGradientBrush>
            <!-- Acier poli (supports, connecteurs) -->
            <LinearGradientBrush x:Key="SkeumoMetal" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FF8D99B1" />
                <GradientStop Offset="0.2" Color="#FFE3E9F4" />
                <GradientStop Offset="0.5" Color="#FF8590A6" />
                <GradientStop Offset="1" Color="#FF3B4558" />
            </LinearGradientBrush>
            <!-- Creux (ouies, fentes) -->
            <LinearGradientBrush x:Key="SkeumoRecess" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FF05070A" />
                <GradientStop Offset="1" Color="#FF232B38" />
            </LinearGradientBrush>
            <!-- Bouton rond : reflet en haut a gauche -->
            <RadialGradientBrush x:Key="SkeumoKnob" GradientOrigin="35%,28%">
                <GradientStop Offset="0" Color="#FFF4F7FC" />
                <GradientStop Offset="0.6" Color="#FFB9C4D8" />
                <GradientStop Offset="1" Color="#FF6F7C93" />
            </RadialGradientBrush>
            <!-- Faisceau de lumiere : de la source vers la transparence -->
            <LinearGradientBrush x:Key="SkeumoBeam" StartPoint="100%,0%" EndPoint="0%,0%">
                <GradientStop Offset="0" Color="#FFDBE8FF" />
                <GradientStop Offset="1" Color="#005B8CFF" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SkeumoEdge" Color="#FF667289" />
            <SolidColorBrush x:Key="SkeumoSlot" Color="#CC0B0F15" />
            <SolidColorBrush x:Key="SkeumoGroove" Color="#B30B0F15" />
            <SolidColorBrush x:Key="SkeumoEngrave" Color="#FF8FA4CC" />
            <SolidColorBrush x:Key="SkeumoRubber" Color="#FF0E1218" />
            <SolidColorBrush x:Key="SkeumoRubberHi" Color="#FF3A4558" />
            <SolidColorBrush x:Key="SkeumoDisplay" Color="#FF101827" />
            <SolidColorBrush x:Key="SkeumoDisplayText" Color="#FFCFE0FF" />
            <!-- Signal en mouvement (impulsion, indicateur actif) -->
            <SolidColorBrush x:Key="SkeumoSignal" Color="#FF7FA3FF" />
            <!-- Tokens Skeumo-Suki étendus (tiges, axes, verre, tubes, cadrans) -->
            <LinearGradientBrush x:Key="SkeumoBase" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FF586278" />
                <GradientStop Offset="0.45" Color="#FF3B4558" />
                <GradientStop Offset="1" Color="#FF171C25" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkeumoRodV" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Offset="0" Color="#FF3B4558" />
                <GradientStop Offset="0.35" Color="#FFE3E9F4" />
                <GradientStop Offset="0.6" Color="#FF8590A6" />
                <GradientStop Offset="1" Color="#FF2A3242" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkeumoRodH" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FF3B4558" />
                <GradientStop Offset="0.28" Color="#FFE3E9F4" />
                <GradientStop Offset="0.62" Color="#FF8590A6" />
                <GradientStop Offset="1" Color="#FF262D3A" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkeumoLeg" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Offset="0" Color="#FF2A3242" />
                <GradientStop Offset="0.3" Color="#FF8D99B1" />
                <GradientStop Offset="0.6" Color="#FF3B4558" />
                <GradientStop Offset="1" Color="#FF171C25" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="SkeumoDarkKnob" GradientOrigin="35%,30%">
                <GradientStop Offset="0" Color="#FF7C88A3" />
                <GradientStop Offset="0.4" Color="#FF3B4558" />
                <GradientStop Offset="0.8" Color="#FF222A38" />
                <GradientStop Offset="1" Color="#FF141922" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="SkeumoAxle" GradientOrigin="35%,30%">
                <GradientStop Offset="0" Color="#FFE3E9F4" />
                <GradientStop Offset="0.4" Color="#FF8D99B1" />
                <GradientStop Offset="0.75" Color="#FF586278" />
                <GradientStop Offset="1" Color="#FF2A3242" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="SkeumoRubberGrad" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FF4A5468" />
                <GradientStop Offset="0.3" Color="#FF262D3A" />
                <GradientStop Offset="1" Color="#FF0B0F15" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkeumoGlassBack" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Offset="0" Color="#B305080D" />
                <GradientStop Offset="0.3" Color="#591A2233" />
                <GradientStop Offset="0.7" Color="#4D1A2233" />
                <GradientStop Offset="1" Color="#BF05080D" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkeumoLiquidShade" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#38FFFFFF" />
                <GradientStop Offset="0.12" Color="#00FFFFFF" />
                <GradientStop Offset="0.8" Color="#00000000" />
                <GradientStop Offset="1" Color="#47000000" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="SkeumoFace" GradientOrigin="38%,30%">
                <GradientStop Offset="0" Color="#FF253049" />
                <GradientStop Offset="0.7" Color="#FF141C2B" />
                <GradientStop Offset="1" Color="#FF0B1019" />
            </RadialGradientBrush>
            <SolidColorBrush x:Key="SkeumoTick" Color="#FF8794A8" />
            <SolidColorBrush x:Key="SkeumoGlassRim" Color="#47FFFFFF" />
            <SolidColorBrush x:Key="SkeumoGlassInner" Color="#59000000" />
            <SolidColorBrush x:Key="SkeumoTrack" Color="#80000000" />
            <SolidColorBrush x:Key="SkeumoTubeRim" Color="#57FFFFFF" />
            <SolidColorBrush x:Key="SkeumoTubeBg" Color="#B805080D" />
            <SolidColorBrush x:Key="SkeumoTubeCore" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="SkeumoLedOff" Color="#FF3A4558" />
            <SolidColorBrush x:Key="SkeumoDeepRecess" Color="#C705080D" />
            <SolidColorBrush x:Key="SkeumoBore" Color="#BF05080D" />
        </ResourceDictionary>

        <!-- ===== Clair ===== -->
        <ResourceDictionary x:Key="Light">
            <LinearGradientBrush x:Key="SkeumoBody" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FFFFFFFF" />
                <GradientStop Offset="0.12" Color="#FFF1F4F9" />
                <GradientStop Offset="0.55" Color="#FFD9E0EC" />
                <GradientStop Offset="1" Color="#FFB0BBCE" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkeumoMetal" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FFC4CDDB" />
                <GradientStop Offset="0.2" Color="#FFFFFFFF" />
                <GradientStop Offset="0.5" Color="#FFCBD3E0" />
                <GradientStop Offset="1" Color="#FF98A4B9" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkeumoRecess" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FF8F9BB0" />
                <GradientStop Offset="1" Color="#FFC3CCDB" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="SkeumoKnob" GradientOrigin="35%,28%">
                <GradientStop Offset="0" Color="#FFFFFFFF" />
                <GradientStop Offset="0.6" Color="#FFF1F4FA" />
                <GradientStop Offset="1" Color="#FFD3DBE8" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="SkeumoBeam" StartPoint="100%,0%" EndPoint="0%,0%">
                <GradientStop Offset="0" Color="#FF3D63C9" />
                <GradientStop Offset="1" Color="#003D63C9" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SkeumoEdge" Color="#FFA3AEC1" />
            <SolidColorBrush x:Key="SkeumoSlot" Color="#668D99B1" />
            <SolidColorBrush x:Key="SkeumoGroove" Color="#554A5670" />
            <SolidColorBrush x:Key="SkeumoEngrave" Color="#FF5A6580" />
            <SolidColorBrush x:Key="SkeumoRubber" Color="#FF6B7790" />
            <SolidColorBrush x:Key="SkeumoRubberHi" Color="#FFA3AEC1" />
            <SolidColorBrush x:Key="SkeumoDisplay" Color="#FF5E6A84" />
            <SolidColorBrush x:Key="SkeumoDisplayText" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SkeumoSignal" Color="#FF3D63C9" />
            <!-- Tokens Skeumo-Suki étendus -->
            <LinearGradientBrush x:Key="SkeumoBase" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FFFFFFFF" />
                <GradientStop Offset="0.45" Color="#FFD9E0EC" />
                <GradientStop Offset="1" Color="#FFB0BBCE" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkeumoRodV" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Offset="0" Color="#FF98A4B9" />
                <GradientStop Offset="0.35" Color="#FFFFFFFF" />
                <GradientStop Offset="0.6" Color="#FFCBD3E0" />
                <GradientStop Offset="1" Color="#FF8D99B1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkeumoRodH" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FF98A4B9" />
                <GradientStop Offset="0.28" Color="#FFFFFFFF" />
                <GradientStop Offset="0.62" Color="#FFCBD3E0" />
                <GradientStop Offset="1" Color="#FF8D99B1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkeumoLeg" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Offset="0" Color="#FFB0BBCE" />
                <GradientStop Offset="0.3" Color="#FFFFFFFF" />
                <GradientStop Offset="0.6" Color="#FFCBD3E0" />
                <GradientStop Offset="1" Color="#FF98A4B9" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="SkeumoDarkKnob" GradientOrigin="35%,30%">
                <GradientStop Offset="0" Color="#FFDDE4F0" />
                <GradientStop Offset="0.35" Color="#FFB5C0D3" />
                <GradientStop Offset="0.8" Color="#FF8793AB" />
                <GradientStop Offset="1" Color="#FF65718A" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="SkeumoAxle" GradientOrigin="35%,30%">
                <GradientStop Offset="0" Color="#FFFFFFFF" />
                <GradientStop Offset="0.4" Color="#FFE3E9F4" />
                <GradientStop Offset="0.75" Color="#FFB0BBCE" />
                <GradientStop Offset="1" Color="#FF8D99B1" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="SkeumoRubberGrad" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FFB4BED0" />
                <GradientStop Offset="0.3" Color="#FF8F9BB2" />
                <GradientStop Offset="1" Color="#FF5E6A84" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkeumoGlassBack" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Offset="0" Color="#4D6F7F9E" />
                <GradientStop Offset="0.3" Color="#14FFFFFF" />
                <GradientStop Offset="0.7" Color="#10FFFFFF" />
                <GradientStop Offset="1" Color="#4D6F7F9E" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkeumoLiquidShade" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#4DFFFFFF" />
                <GradientStop Offset="0.12" Color="#00FFFFFF" />
                <GradientStop Offset="0.8" Color="#00FFFFFF" />
                <GradientStop Offset="1" Color="#26405070" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="SkeumoFace" GradientOrigin="38%,30%">
                <GradientStop Offset="0" Color="#FFFFFFFF" />
                <GradientStop Offset="0.7" Color="#FFEEF2F8" />
                <GradientStop Offset="1" Color="#FFD3DBE8" />
            </RadialGradientBrush>
            <SolidColorBrush x:Key="SkeumoTick" Color="#FF7A869C" />
            <SolidColorBrush x:Key="SkeumoGlassRim" Color="#73607090" />
            <SolidColorBrush x:Key="SkeumoGlassInner" Color="#40405070" />
            <SolidColorBrush x:Key="SkeumoTrack" Color="#26405070" />
            <SolidColorBrush x:Key="SkeumoTubeRim" Color="#FF98A4B9" />
            <SolidColorBrush x:Key="SkeumoTubeBg" Color="#FFD3DBE8" />
            <SolidColorBrush x:Key="SkeumoTubeCore" Color="#FFF4F7FB" />
            <SolidColorBrush x:Key="SkeumoLedOff" Color="#FFB0BBCE" />
            <SolidColorBrush x:Key="SkeumoDeepRecess" Color="#FF5E6A84" />
            <SolidColorBrush x:Key="SkeumoBore" Color="#668A99B5" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
