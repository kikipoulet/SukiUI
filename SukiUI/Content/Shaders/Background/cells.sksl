vec3 blendOverlay(vec3 base, vec3 blend) {
     return vec3(
         base.r < 0.5 ? (2.0 * base.r * blend.r) : (1.0 - 2.0 * (1.0 - base.r) * (1.0 - blend.r)),
         base.g < 0.5 ? (2.0 * base.g * blend.g) : (1.0 - 2.0 * (1.0 - base.g) * (1.0 - blend.g)),
         base.b < 0.5 ? (2.0 * base.b * blend.b) : (1.0 - 2.0 * (1.0 - base.b) * (1.0 - blend.b))
     );
}

vec2 hash22(vec2 value) {
    value = fract(value * vec2(123.34, 456.21));
    value += dot(value, value + 45.32);
    return fract(vec2(value.x * value.y, value.x + value.y));
}

vec2 pointForCell(vec2 id) {
    vec2 random = hash22(id);
    vec2 phase = fract(random.yx + iTime * vec2(0.037, 0.061));
    vec2 triangularMotion = abs(phase * 2.0 - 1.0) - 0.5;
    return vec2(0.5) + triangularMotion * 0.34;
}

vec4 main(vec2 fragCoord)
{
    float size = 10.;
    vec2 uv = (fragCoord - .5 * iResolution.xy) / iResolution.x * size;

    vec2 gv = fract(uv);
    vec2 id = floor(uv);
    vec2 neighborDirection = mix(vec2(-1.0), vec2(1.0), step(vec2(0.5), gv));

    float minimumDistanceSquared = 1e9;
    vec2 nearestCellId = id;
    for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 2; j++) {
            vec2 cellOffset = vec2(float(i) * neighborDirection.x, float(j) * neighborDirection.y);
            vec2 cellPoint = pointForCell(id + cellOffset);
            vec2 delta = gv - (cellOffset + cellPoint);
            float distanceSquared = dot(delta, delta);
            if (distanceSquared < minimumDistanceSquared) {
                minimumDistanceSquared = distanceSquared;
                nearestCellId = id + cellOffset;
            }
        }
    }

    vec2 cellColor = hash22(nearestCellId);
    vec3 col = mix(iPrimary, iAccent, cellColor.x * 0.7 + cellColor.y * 0.3);
    vec3 comp = blendOverlay(iBase, col);
    return vec4(comp, iAlpha);
}
