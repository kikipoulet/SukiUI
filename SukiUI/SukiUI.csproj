<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UserSecretsId>712f85e4-12d3-41b0-a417-5714a113666f</UserSecretsId>

    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Title>SukiUI</Title>
    <Description>A modern, elegant desktop UI theme and controls library for Avalonia UI with rich animations, dynamic themes, customizable backgrounds, and an extensive control toolkit.</Description>
    <PackageTags>avalonia;avaloniaui;ui;theme;controls;desktop;fluent;modern;styling;animation;sukiui</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Simple" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SukiUI.Motion\SukiUI.Motion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="**\*.xaml" />
    <AvaloniaResource Include="Content\Images\*.png" />
    <AvaloniaResource Include="Roboto-*.ttf" />
    <AvaloniaResource Include="CustomFont\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Content\Shaders\**\*.sksl" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Controls\Hosts\SukiToastHost.cs">
      <DependentUpon>SukiToastHost.axaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\Hosts\SukiDialogHost.cs">
      <DependentUpon>SukiDialogHost.axaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\SukiDialog.cs">
      <DependentUpon>SukiDialog.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
