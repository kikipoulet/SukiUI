<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Sizes of Button for every SukiCompactness level. Normal is the complete set (the historical
         values); the other levels only list what differs. Key names: SukiButton<Class><Property>. -->

    <ResourceDictionary x:Key="Normal">
        <!-- default -->
        <x:Double x:Key="SukiButtonFontSize">15</x:Double>
        <Thickness x:Key="SukiButtonBorderThickness">1.2</Thickness>
        <Thickness x:Key="SukiButtonPadding">20,8</Thickness>
        <!-- busy indicator shown by ButtonExtensions.ShowProgress -->
        <x:Double x:Key="SukiButtonProgressSize">24</x:Double>
        <Thickness x:Key="SukiButtonProgressMargin">0,-5,-10,-5</Thickness>
        <!-- .Basic -->
        <Thickness x:Key="SukiButtonBasicPadding">11,8</Thickness>
        <!-- .Small -->
        <x:Double x:Key="SukiButtonSmallFontSize">15</x:Double>
        <Thickness x:Key="SukiButtonSmallPadding">10</Thickness>
        <!-- .Large -->
        <x:Double x:Key="SukiButtonLargeFontSize">18</x:Double>
        <Thickness x:Key="SukiButtonLargePadding">30,12</Thickness>
        <!-- .Icon -->
        <x:Double x:Key="SukiButtonIconSize">40</x:Double>
        <x:Double x:Key="SukiButtonIconFontSize">20</x:Double>
        <!-- .Card -->
        <Thickness x:Key="SukiButtonCardPadding">20</Thickness>
        <Thickness x:Key="SukiButtonCardMargin">7</Thickness>
    </ResourceDictionary>

    <ResourceDictionary x:Key="SuperCompact">
        <x:Double x:Key="SukiButtonFontSize">13</x:Double>
        <Thickness x:Key="SukiButtonPadding">12,4</Thickness>
        <x:Double x:Key="SukiButtonProgressSize">18</x:Double>
        <Thickness x:Key="SukiButtonProgressMargin">0,-3,-6,-3</Thickness>
        <Thickness x:Key="SukiButtonBasicPadding">7,4</Thickness>
        <x:Double x:Key="SukiButtonSmallFontSize">12</x:Double>
        <Thickness x:Key="SukiButtonSmallPadding">6</Thickness>
        <x:Double x:Key="SukiButtonLargeFontSize">15</x:Double>
        <Thickness x:Key="SukiButtonLargePadding">20,8</Thickness>
        <x:Double x:Key="SukiButtonIconSize">28</x:Double>
        <x:Double x:Key="SukiButtonIconFontSize">14</x:Double>
        <Thickness x:Key="SukiButtonCardPadding">12</Thickness>
        <Thickness x:Key="SukiButtonCardMargin">4</Thickness>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Compact">
        <x:Double x:Key="SukiButtonFontSize">14</x:Double>
        <Thickness x:Key="SukiButtonPadding">16,6</Thickness>
        <x:Double x:Key="SukiButtonProgressSize">22</x:Double>
        <Thickness x:Key="SukiButtonProgressMargin">0,-4,-8,-4</Thickness>
        <Thickness x:Key="SukiButtonBasicPadding">9,6</Thickness>
        <x:Double x:Key="SukiButtonSmallFontSize">14</x:Double>
        <Thickness x:Key="SukiButtonSmallPadding">8</Thickness>
        <x:Double x:Key="SukiButtonLargeFontSize">16</x:Double>
        <Thickness x:Key="SukiButtonLargePadding">24,10</Thickness>
        <x:Double x:Key="SukiButtonIconSize">34</x:Double>
        <x:Double x:Key="SukiButtonIconFontSize">17</x:Double>
        <Thickness x:Key="SukiButtonCardPadding">16</Thickness>
        <Thickness x:Key="SukiButtonCardMargin">5</Thickness>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Big">
        <x:Double x:Key="SukiButtonFontSize">17</x:Double>
        <Thickness x:Key="SukiButtonPadding">24,11</Thickness>
        <x:Double x:Key="SukiButtonProgressSize">28</x:Double>
        <Thickness x:Key="SukiButtonProgressMargin">0,-6,-12,-6</Thickness>
        <Thickness x:Key="SukiButtonBasicPadding">14,11</Thickness>
        <x:Double x:Key="SukiButtonSmallFontSize">16</x:Double>
        <Thickness x:Key="SukiButtonSmallPadding">12</Thickness>
        <x:Double x:Key="SukiButtonLargeFontSize">20</x:Double>
        <Thickness x:Key="SukiButtonLargePadding">36,15</Thickness>
        <x:Double x:Key="SukiButtonIconSize">48</x:Double>
        <x:Double x:Key="SukiButtonIconFontSize">24</x:Double>
        <Thickness x:Key="SukiButtonCardPadding">26</Thickness>
        <Thickness x:Key="SukiButtonCardMargin">9</Thickness>
    </ResourceDictionary>

</ResourceDictionary>
