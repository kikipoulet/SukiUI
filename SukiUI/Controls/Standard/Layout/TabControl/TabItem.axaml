<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:animations="clr-namespace:SukiUI.ControlsAnimation">
    <Design.PreviewWith>
        <Border Width="400" Height="400">
            <Panel>
                <TabControl Classes="Pill" Margin="0,0,0,200" >
                    <TabItem Classes="Pill" Header="Arch">
                        <Border Height="100" Background="AntiqueWhite">
                            <TextBlock FontSize="20"
                                       Foreground="Black"
                                       Text="Content" />
                        </Border>
                    </TabItem>
                    <TabItem Classes="Pill" Header="Leaf">
                        <Border Height="100" Background="Green" />
                    </TabItem>
                    <TabItem Classes="Pill" Header="Leaf">
                        <Border Height="100" Background="Green" />
                    </TabItem>
                    <TabItem Classes="Pill" Header="Leaf">
                        <Border Height="100" Background="Green" />
                    </TabItem>
                    <TabItem Classes="Pill" Header="Leaf">
                        <Border Height="100" Background="Green" />
                    </TabItem>
                </TabControl>
            </Panel>
        </Border>
    </Design.PreviewWith>
    <ControlTheme x:Key="SukiTabItemStyle" TargetType="TabItem">
        <!--  Sizes follow the compactness level (TabItem.Compactness.axaml).  -->
        <Setter Property="FontSize" Value="{DynamicResource SukiCompactness.TabItem.FontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="0" />
        <!--  No MinHeight: the height is the content and the compactness level, never a resource
              borrowed from another theme (Fluent's TabItemMinHeight held every level at 48).  -->
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Bottom" />
        <!--  Hover and press live in SukiTabItemMotion; the selection is the strip's indicator
              (SukiTabControlMotion), which takes the bounds of PART_IndicatorAnchor.  -->
        <Setter Property="animations:SukiTabItemMotion.Enable" Value="True" />
        <Setter Property="animations:SukiTabControlMotion.Indicator" Value="Underline" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_LayoutRoot"
                        Margin="{DynamicResource SukiCompactness.TabItem.LayoutRoot.Margin}"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid RowDefinitions="*,Auto">
                        <Border Name="PART_HoverPlate"
                                Margin="{DynamicResource SukiCompactness.TabItem.HoverPlate.Margin}"
                                Background="{DynamicResource SukiPrimaryColor5}"
                                CornerRadius="{DynamicResource SmallCornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        <ContentPresenter Name="PART_HeaderPresenter"
                                          Padding="{DynamicResource SukiCompactness.TabItem.HeaderPresenter.Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalContentAlignment="Center"
                                          RecognizesAccessKey="True"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                          TextBlock.FontSize="{TemplateBinding FontSize}"
                                          TextBlock.FontWeight="{TemplateBinding FontWeight}">
                            <ContentPresenter.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Foreground" Duration="0:0:0.1" />
                                </Transitions>
                            </ContentPresenter.Transitions>
                        </ContentPresenter>
                        <!--  Where the underline lands: the indicator itself is drawn by the strip.  -->
                        <Border Name="PART_IndicatorAnchor"
                                Grid.Row="1"
                                Height="{DynamicResource SukiCompactness.TabItem.IndicatorAnchor.Height}"
                                Margin="{DynamicResource SukiCompactness.TabItem.IndicatorAnchor.Margin}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^.Pill">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="100" />
            <!--  One padding for every state: the pill travels, the tabs never change size.  -->
            <Setter Property="Padding" Value="{DynamicResource SukiCompactness.TabItem.Pill.Padding}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="animations:SukiTabControlMotion.Indicator" Value="Pill" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="PART_IndicatorAnchor" Margin="{DynamicResource SukiCompactness.TabItem.Pill.Margin}" />
                        <Border Name="PART_HoverPlate"
                                Margin="{DynamicResource SukiCompactness.TabItem.Pill.Margin}"
                                Background="{DynamicResource SukiPrimaryColor5}"
                                CornerRadius="100"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        <Border Name="PART_LayoutRoot"
                                Margin="{DynamicResource SukiCompactness.TabItem.Pill.Margin}"
                                VerticalAlignment="Center"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="100">
                            <ContentPresenter Name="PART_HeaderPresenter"
                                              Padding="{DynamicResource SukiCompactness.TabItem.Pill.HeaderPresenter.Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalContentAlignment="Center"
                                              RecognizesAccessKey="True"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}">
                                <ContentPresenter.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="Foreground" Duration="0:0:0.1" />
                                    </Transitions>
                                </ContentPresenter.Transitions>
                            </ContentPresenter>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^ /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{Binding $parent[TabItem].Background}" />
        </Style>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
                <Setter Property="TextBlock.Foreground" Value="{DynamicResource SukiPrimaryColor75}" />
            </Style>
        </Style>

        <Style Selector="^:selected">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{DynamicResource SmallCornerRadius}" />
            <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
                <Setter Property="TextBlock.Foreground" Value="{DynamicResource SukiPrimaryColor120}" />
            </Style>
        </Style>

        <Style Selector="^.Pill:selected">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{DynamicResource SmallCornerRadius}" />
            <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
                <!--  The text of the tab the pill heads for turns white once the pill starts to
                      cover it; the tab it leaves turns back at once (the base transition).  -->
                <Setter Property="Transitions">
                    <Transitions>
                        <BrushTransition Property="Foreground" Delay="0:0:0.07" Duration="0:0:0.12" />
                    </Transitions>
                </Setter>
                <Setter Property="TextBlock.Foreground" Value="White" />
            </Style>
        </Style>

        <Style Selector="^[IsEnabled=False]">
            <Setter Property="Foreground" Value="{DynamicResource SukiDisabledText}" />
        </Style>

        <Style Selector="^[TabStripPlacement=Bottom]">
            <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
                <Setter Property="DockPanel.Dock" Value="Bottom" />
                <Setter Property="Margin" Value="0,0,0,0" />
            </Style>
            <Style Selector="^ /template/ Border#PART_IndicatorAnchor">
                <Setter Property="Margin" Value="{DynamicResource SukiCompactness.TabItem.IndicatorAnchor.Margin}" />
            </Style>
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type TabItem}"
                  BasedOn="{StaticResource SukiTabItemStyle}"
                  TargetType="TabItem" />
</ResourceDictionary>
