<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Everything that can live in a ControlTheme is in Theme/DataGrid.axaml. Only rules that have to
        reach a descendant belong here, because a ControlTheme rejects child and descendant selectors
        (Selector.ValidateNestingSelector). Column headers, rows, row headers and group headers are
        generated by the presenters rather than named in the DataGrid template, so /template/ cannot
        reach them either - a DataGrid-level class or property can only be forwarded from a
        descendant selector.
    -->
    <Style Selector="DataGridColumnHeader TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--
        Row header rule follows GridLinesVisibility. The template defaults it off so the None and
        Horizontal modes leave the row header edge clean, matching the cells.
    -->
    <Style Selector="DataGrid[GridLinesVisibility=Vertical] DataGridRowHeader /template/ Border#RowHeaderBorder">
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style Selector="DataGrid[GridLinesVisibility=All] DataGridRowHeader /template/ Border#RowHeaderBorder">
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <!--
        Same for the horizontal rule. DataGridRow.PART_BottomGridLine is confined to the cells column,
        so without this the horizontal grid line stops at the row header instead of crossing it.
    -->
    <Style Selector="DataGrid[GridLinesVisibility=Horizontal] DataGridRowHeader /template/ Rectangle#HorizontalSeparator">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="DataGrid[GridLinesVisibility=All] DataGridRowHeader /template/ Rectangle#HorizontalSeparator">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <!--  Flat: the filled variant, matching Button.Flat - a solid primary header band and no rules.  -->
    <Style Selector="DataGrid.Flat">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="DataGrid.Flat DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SeparatorBrush" Value="#33FFFFFF" />
    </Style>

    <Style Selector="DataGrid.Flat DataGridColumnHeader TextBlock">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="DataGrid.Flat DataGridColumnHeader:pointerover /template/ Grid#PART_ColumnHeaderRoot">
        <Setter Property="Background" Value="#26FFFFFF" />
    </Style>

    <Style Selector="DataGrid.Flat DataGridColumnHeader:pressed /template/ Grid#PART_ColumnHeaderRoot">
        <Setter Property="Background" Value="#40FFFFFF" />
    </Style>

    <!--
        Accent: the colour variant, matching Button.Accent - swaps the primary tints for the accent
        ones. Composes with Flat the same way Button.Flat.Accent does.
    -->
    <Style Selector="DataGrid.Accent DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource SukiAccentColor10}" />
    </Style>

    <Style Selector="DataGrid.Accent DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource SukiAccentColor15}" />
    </Style>

    <Style Selector="DataGrid.Accent DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource SukiAccentColor20}" />
    </Style>

    <Style Selector="DataGrid.Accent DataGridRowHeader:current /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource SukiAccentColor10}" />
    </Style>

    <Style Selector="DataGrid.Accent DataGridRowHeader:selected /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource SukiAccentColor15}" />
    </Style>

    <Style Selector="DataGrid.Accent DataGridColumnHeader:pointerover /template/ Grid#PART_ColumnHeaderRoot">
        <Setter Property="Background" Value="{DynamicResource SukiAccentColor7}" />
    </Style>

    <Style Selector="DataGrid.Accent DataGridColumnHeader:pressed /template/ Grid#PART_ColumnHeaderRoot">
        <Setter Property="Background" Value="{DynamicResource SukiAccentColor15}" />
    </Style>

    <Style Selector="DataGrid.Accent DataGridRowGroupHeader:pointerover /template/ Rectangle#HoverRectangle">
        <Setter Property="Fill" Value="{DynamicResource SukiAccentColor7}" />
    </Style>

    <Style Selector="DataGrid.Accent DataGridRowGroupHeader:pressed /template/ Rectangle#HoverRectangle">
        <Setter Property="Fill" Value="{DynamicResource SukiAccentColor15}" />
    </Style>

    <!--  Flat and Accent together: the header band takes the accent colour instead of the primary.  -->
    <Style Selector="DataGrid.Flat.Accent DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource SukiAccentColor}" />
    </Style>
</Styles>
