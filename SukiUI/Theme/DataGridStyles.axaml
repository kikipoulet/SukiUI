<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Everything that can live in a ControlTheme is in Theme/DataGrid.axaml. Only rules that have to
        reach a non-template descendant belong here, because a ControlTheme rejects child and
        descendant selectors (Selector.ValidateNestingSelector).
    -->
    <Style Selector="DataGridColumnHeader TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
</Styles>
