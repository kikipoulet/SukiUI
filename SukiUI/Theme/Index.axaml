<Styles x:Class="SukiUI.SukiTheme"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:SukiUI.Animations"
        xmlns:system="clr-namespace:System;assembly=netstandard">

    <SimpleTheme />

        <StyleInclude Source="avares://SukiUI/Theme/TextStyles.axaml" />
        <StyleInclude Source="avares://SukiUI/Controls/Suki/Containers/SettingsLayout/SettingsLayoutStyles.axaml" />

        <StyleInclude Source="avares://SukiUI/Theme/ColorsStyles.xaml" />

        <StyleInclude Source="avares://SukiUI/Theme/BorderStyles.xaml" />

        <StyleInclude Source="avares://SukiUI/Theme/TreeViewStyles.xaml" />

        <StyleInclude Source="avares://SukiUI/Theme/ToolTipBehaviorStyles.axaml" />
        <StyleInclude Source="avares://SukiUI/Theme/RadioButtonVariantsStyles.xaml" />
        <StyleInclude Source="avares://SukiUI/Theme/SliderStyles.xaml" />
        <StyleInclude Source="avares://SukiUI/Theme/ScrollBarBehaviorStyles.axaml" />
        <StyleInclude Source="avares://SukiUI/Theme/PopupBehaviorStyles.axaml" />
        <StyleInclude Source="avares://SukiUI/Theme/ButtonLoadingStyles.axaml" />
        <StyleInclude Source="avares://SukiUI/Theme/TabItemGlassStyles.xaml" />
        <StyleInclude Source="avares://SukiUI/Controls/Suki/DataDisplay/Gauges/HorizontalBarMeter/HorizontalBarMeterStyles.axaml"/>
        <StyleInclude Source="avares://SukiUI/Controls/Suki/DataDisplay/Gauges/VerticalBarMeter/VerticalBarMeterStyles.axaml"/>
        <StyleInclude Source="avares://SukiUI/Controls/Suki/DataDisplay/Gauges/RadialGauge/RadialGaugeStyles.axaml"/>


    <Styles.Resources>
        <ResourceDictionary>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Light" Source="../ColorTheme/Light.axaml" />
                <ResourceInclude x:Key="Dark" Source="../ColorTheme/Dark.axaml" />
            </ResourceDictionary.ThemeDictionaries>

            <CornerRadius x:Key="SmallCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="MediumCornerRadius">15</CornerRadius>

            <system:TimeSpan x:Key="LongAnimationDuration">0.5</system:TimeSpan>
            <system:TimeSpan x:Key="MediumAnimationDuration">0.35</system:TimeSpan>
            <system:TimeSpan x:Key="ShortAnimationDuration">0.2</system:TimeSpan>

            <animations:SukiEaseOutBack x:Key="MenuEasing" BounceIntensity="Soft" />


            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://sukiUI/Theme/TextBlock.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/TextBox.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/NumericUpDown.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/Button.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/ToggleButton.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/ToggleSwitch.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/SplitButton.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/ProgressBar.axaml" />
                <ResourceInclude Source="avares://SukiUI/Theme/SplitView.axaml" />
                <ResourceInclude Source="avares://SukiUI/Theme/DatePicker.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/HyperlinkButton.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/PathIcon.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/Expander.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/CalendarDatePicker.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/TabControl.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/TabItem.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/Separator.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/DropDownButton.axaml" />
                <ResourceInclude Source="avares://SukiUI/Theme/ListBoxItem.axaml" />
                <ResourceInclude Source="avares://SukiUI/Theme/ListBox.xaml" />
                <ResourceInclude Source="avares://SukiUI/Theme/ComboBoxItem.axaml" />
                <ResourceInclude Source="avares://SukiUI/Theme/ComboBox.xaml" />
                <ResourceInclude Source="avares://SukiUI/Theme/GridSplitter.axaml" />
                <ResourceInclude Source="avares://SukiUI/Controls/Standard/CheckBox/CheckBox.axaml" />
                <ResourceInclude Source="avares://SukiUI/Theme/ToolTip.axaml" />
                <ResourceInclude Source="avares://SukiUI/Theme/RadioButton.xaml" />
                <ResourceInclude Source="avares://SukiUI/Theme/ScrollBar.axaml" />
                <ResourceInclude Source="avares://SukiUI/Theme/Notification.axaml" />
                <ResourceInclude Source="avares://SukiUI/Theme/NotificationCard.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/ScrollViewer.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/MenuScrollViewer.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/Menu.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/ContextMenu.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/MenuItem.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/FlyoutPresenter.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/MenuFlyoutPresenter.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/AutoCompleteBox.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/ManagedFileChooser.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/TextResetButton.axaml" />
                <ResourceInclude Source="avares://SukiUI/Theme/TreeViewItem.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/TimePicker.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/Calendar/Calendar.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/Calendar/CalendarButton.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/Calendar/CalendarDayButton.axaml" />
                <ResourceInclude Source="avares://sukiUI/Theme/Calendar/CalendarItem.axaml" />

                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Windowing/SukiMainHost/SukiMainHost.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Windowing/SukiWindow/SukiWindow.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Overlays/Toast/SukiToast.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Overlays/Toast/SukiToastHost.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Overlays/Dialog/SukiDialogHost.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Overlays/MessageBox/SukiMessageBoxHost.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Containers/GroupBox/GroupBox.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Overlays/Dialog/SukiDialog.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Navigation/SukiSideMenu/SukiSideMenu.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Navigation/SukiStackPage/SukiStackPage.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Navigation/SukiSideMenu/SukiSideMenuItem.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Navigation/SukiTransitioningContentControl/SukiTransitioningContentControl.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Feedback/Stepper/Stepper.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Feedback/VerticalStepper/VerticalStepper.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Feedback/InfoBadge/InfoBadge.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Feedback/InfoBar/InfoBar.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Containers/GlassCard/GlassCard.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Containers/ContentExpandControl/ContentExpandControl.axaml" />

                <ResourceInclude Source="avares://SukiUI/Locale/en-US.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
