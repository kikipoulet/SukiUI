<Styles x:Class="SukiUI.SukiTheme"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:SukiUI.Animations"
        xmlns:system="clr-namespace:System;assembly=netstandard">

    <SimpleTheme />

        <StyleInclude Source="avares://SukiUI/Theme/TextStyles.axaml" />
        <StyleInclude Source="avares://SukiUI/Controls/Suki/Containers/SettingsLayout/SettingsLayoutStyles.axaml" />

        <StyleInclude Source="avares://SukiUI/Theme/ColorsStyles.xaml" />

        <StyleInclude Source="avares://SukiUI/Theme/BorderStyles.xaml" />

        <StyleInclude Source="avares://SukiUI/Controls/Standard/Collections/TreeView/TreeViewStyles.xaml" />

        <StyleInclude Source="avares://SukiUI/Controls/Standard/Menus/ToolTip/ToolTipBehaviorStyles.axaml" />
        <StyleInclude Source="avares://SukiUI/Controls/Standard/Selection/RadioButton/RadioButtonVariantsStyles.xaml" />
        <StyleInclude Source="avares://SukiUI/Controls/Standard/Selection/Slider/SliderStyles.xaml" />
        <StyleInclude Source="avares://SukiUI/Controls/Standard/Layout/ScrollBar/ScrollBarBehaviorStyles.axaml" />
        <StyleInclude Source="avares://SukiUI/Theme/PopupBehaviorStyles.axaml" />
        <StyleInclude Source="avares://SukiUI/Controls/Standard/Buttons/Button/ButtonLoadingStyles.axaml" />
        <StyleInclude Source="avares://SukiUI/Controls/Standard/Layout/TabControl/TabItemGlassStyles.xaml" />
        <StyleInclude Source="avares://SukiUI/Controls/Suki/DataDisplay/Gauges/HorizontalBarMeter/HorizontalBarMeterStyles.axaml"/>
        <StyleInclude Source="avares://SukiUI/Controls/Suki/DataDisplay/Gauges/VerticalBarMeter/VerticalBarMeterStyles.axaml"/>
        <StyleInclude Source="avares://SukiUI/Controls/Suki/DataDisplay/Gauges/RadialGauge/RadialGaugeStyles.axaml"/>


    <Styles.Resources>
        <ResourceDictionary>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Light" Source="../ColorTheme/Light.axaml" />
                <ResourceInclude x:Key="Dark" Source="../ColorTheme/Dark.axaml" />
            </ResourceDictionary.ThemeDictionaries>

            <CornerRadius x:Key="SmallCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="MediumCornerRadius">15</CornerRadius>

            <system:TimeSpan x:Key="LongAnimationDuration">0.5</system:TimeSpan>
            <system:TimeSpan x:Key="MediumAnimationDuration">0.35</system:TimeSpan>
            <system:TimeSpan x:Key="ShortAnimationDuration">0.2</system:TimeSpan>

            <animations:SukiEaseOutBack x:Key="MenuEasing" BounceIntensity="Soft" />


            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/TextInput/TextBlock/TextBlock.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/TextInput/TextBox/TextBox.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/TextInput/NumericUpDown/NumericUpDown.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Buttons/Button/Button.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Buttons/ToggleButton/ToggleButton.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Selection/ToggleSwitch/ToggleSwitch.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Buttons/SplitButton/SplitButton.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Feedback/ProgressBar/ProgressBar.axaml" />
                <ResourceInclude Source="avares://SukiUI/Controls/Standard/Layout/SplitView/SplitView.axaml" />
                <ResourceInclude Source="avares://SukiUI/Controls/Standard/Pickers/DatePicker/DatePicker.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Buttons/HyperlinkButton/HyperlinkButton.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Misc/PathIcon/PathIcon.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Layout/Expander/Expander.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Pickers/CalendarDatePicker/CalendarDatePicker.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Layout/TabControl/TabControl.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Layout/TabControl/TabItem.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Layout/Separator/Separator.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Buttons/DropDownButton/DropDownButton.axaml" />
                <ResourceInclude Source="avares://SukiUI/Controls/Standard/Collections/ListBox/ListBoxItem.axaml" />
                <ResourceInclude Source="avares://SukiUI/Controls/Standard/Collections/ListBox/ListBox.xaml" />
                <ResourceInclude Source="avares://SukiUI/Controls/Standard/Pickers/ComboBox/ComboBoxItem.axaml" />
                <ResourceInclude Source="avares://SukiUI/Controls/Standard/Pickers/ComboBox/ComboBox.xaml" />
                <ResourceInclude Source="avares://SukiUI/Controls/Standard/Layout/GridSplitter/GridSplitter.axaml" />
                <ResourceInclude Source="avares://SukiUI/Controls/Standard/Selection/CheckBox/CheckBox.axaml" />
                <ResourceInclude Source="avares://SukiUI/Controls/Standard/Menus/ToolTip/ToolTip.axaml" />
                <ResourceInclude Source="avares://SukiUI/Controls/Standard/Selection/RadioButton/RadioButton.xaml" />
                <ResourceInclude Source="avares://SukiUI/Controls/Standard/Layout/ScrollBar/ScrollBar.axaml" />
                <ResourceInclude Source="avares://SukiUI/Controls/Standard/Feedback/Notification/Notification.axaml" />
                <ResourceInclude Source="avares://SukiUI/Controls/Standard/Feedback/NotificationCard/NotificationCard.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Layout/ScrollViewer/ScrollViewer.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Menus/Menu/MenuScrollViewer.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Menus/Menu/Menu.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Menus/ContextMenu/ContextMenu.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Menus/MenuItem/MenuItem.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Menus/FlyoutPresenter/FlyoutPresenter.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Menus/MenuFlyoutPresenter/MenuFlyoutPresenter.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/TextInput/AutoCompleteBox/AutoCompleteBox.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Misc/ManagedFileChooser/ManagedFileChooser.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/TextInput/TextResetButton/TextResetButton.axaml" />
                <ResourceInclude Source="avares://SukiUI/Controls/Standard/Collections/TreeView/TreeViewItem.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Pickers/TimePicker/TimePicker.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Pickers/Calendar/Calendar.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Pickers/Calendar/CalendarButton.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Pickers/Calendar/CalendarDayButton.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Standard/Pickers/Calendar/CalendarItem.axaml" />

                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Windowing/SukiMainHost/SukiMainHost.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Windowing/SukiWindow/SukiWindow.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Overlays/Toast/SukiToast.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Overlays/Toast/SukiToastHost.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Overlays/Dialog/SukiDialogHost.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Overlays/MessageBox/SukiMessageBoxHost.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Containers/GroupBox/GroupBox.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Overlays/Dialog/SukiDialog.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Navigation/SukiSideMenu/SukiSideMenu.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Navigation/SukiStackPage/SukiStackPage.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Navigation/SukiSideMenu/SukiSideMenuItem.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Navigation/SukiTransitioningContentControl/SukiTransitioningContentControl.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Feedback/Stepper/Stepper.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Feedback/VerticalStepper/VerticalStepper.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Feedback/InfoBadge/InfoBadge.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Feedback/InfoBar/InfoBar.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Containers/GlassCard/GlassCard.axaml" />
                <ResourceInclude Source="avares://sukiUI/Controls/Suki/Containers/ContentExpandControl/ContentExpandControl.axaml" />

                <ResourceInclude Source="avares://SukiUI/Locale/en-US.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
