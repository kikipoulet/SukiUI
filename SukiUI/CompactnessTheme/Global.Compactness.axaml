<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The global sizing tokens shared by many controls, for every SukiCompactness level. They keep their
         historical names (a resource set in Application.Resources still overrides them at every level);
         the per-control values live next to each control in its own *.Compactness.axaml. -->

    <ResourceDictionary x:Key="Normal">
        <CornerRadius x:Key="SmallCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="MediumCornerRadius">15</CornerRadius>
    </ResourceDictionary>

    <ResourceDictionary x:Key="SuperCompact">
        <CornerRadius x:Key="SmallCornerRadius">5</CornerRadius>
        <CornerRadius x:Key="MediumCornerRadius">10</CornerRadius>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Compact">
        <CornerRadius x:Key="SmallCornerRadius">7</CornerRadius>
        <CornerRadius x:Key="MediumCornerRadius">13</CornerRadius>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Big">
        <CornerRadius x:Key="SmallCornerRadius">10</CornerRadius>
        <CornerRadius x:Key="MediumCornerRadius">18</CornerRadius>
    </ResourceDictionary>

</ResourceDictionary>
