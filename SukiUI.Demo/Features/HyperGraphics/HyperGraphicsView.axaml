<UserControl x:Class="SukiUI.Demo.Features.HyperGraphics.HyperGraphicsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:hyper="clr-namespace:SukiUI.Demo.Features.HyperGraphics"
             xmlns:mini3d="clr-namespace:SukiUI.Demo.Features.HyperGraphics.Mini3D"
             xmlns:skeumorphism="clr-namespace:SukiUI.Demo.Features.HyperGraphics.Skeumorphism"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:DataType="hyper:HyperGraphicsViewModel"
             mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="suki|SukiSideMenu /template/ suki|GlassCard#Glass">
            <Setter Property="Opacity" Value="0.75" />
        </Style>
    </UserControl.Styles>

    <suki:SukiSideMenu Margin="0">
        <suki:SukiSideMenu.Items>
            <suki:SukiSideMenuItem Classes="Compact" Header="HyperSVG">
                <suki:SukiSideMenuItem.Icon>
                    <PathIcon Data="{x:Static suki:Icons.ChevronRight}"
                              Foreground="{DynamicResource SukiLowText}"
                              Width="13" Height="13"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </suki:SukiSideMenuItem.Icon>
                <suki:SukiSideMenuItem.PageContent>
                    <ScrollViewer>
                        <skeumorphism:SkeumorphismPage />
                    </ScrollViewer>
                </suki:SukiSideMenuItem.PageContent>
            </suki:SukiSideMenuItem>

            <suki:SukiSideMenuItem Classes="Compact" Header="HyperMini3D">
                <suki:SukiSideMenuItem.Icon>
                    <PathIcon Data="{x:Static suki:Icons.ChevronRight}"
                              Foreground="{DynamicResource SukiLowText}"
                              Width="13" Height="13"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </suki:SukiSideMenuItem.Icon>
                <suki:SukiSideMenuItem.PageContent>
                    <ScrollViewer>
                        <mini3d:Mini3DPage />
                    </ScrollViewer>
                </suki:SukiSideMenuItem.PageContent>
            </suki:SukiSideMenuItem>
        </suki:SukiSideMenu.Items>

        <suki:SukiSideMenu.HeaderContent>
            <Panel />
        </suki:SukiSideMenu.HeaderContent>

        <suki:SukiSideMenu.FooterContent>
            <Panel />
        </suki:SukiSideMenu.FooterContent>
    </suki:SukiSideMenu>
</UserControl>
