<!-- Skeumo-Suki shared materials (prefix Sk): the slate-blue metal ramp, glass, rubber and shadows,
     in a Dark and a Light version. Included by every skeumorphic control; component-specific tokens keep their own prefix. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <LinearGradientBrush x:Key="SkBase" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FF586278" />
                <GradientStop Offset="0.45" Color="#FF3B4558" />
                <GradientStop Offset="1" Color="#FF171C25" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkBody" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FF586278" />
                <GradientStop Offset="0.12" Color="#FF3B4558" />
                <GradientStop Offset="0.55" Color="#FF2A3242" />
                <GradientStop Offset="1" Color="#FF171C25" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkRodV" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Offset="0" Color="#FF3B4558" />
                <GradientStop Offset="0.35" Color="#FFE3E9F4" />
                <GradientStop Offset="0.6" Color="#FF8590A6" />
                <GradientStop Offset="1" Color="#FF2A3242" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkRodH" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FF3B4558" />
                <GradientStop Offset="0.28" Color="#FFE3E9F4" />
                <GradientStop Offset="0.62" Color="#FF8590A6" />
                <GradientStop Offset="1" Color="#FF262D3A" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="SkKnob" GradientOrigin="35%,30%">
                <GradientStop Offset="0" Color="#FF7C88A3" />
                <GradientStop Offset="0.4" Color="#FF3B4558" />
                <GradientStop Offset="0.8" Color="#FF222A38" />
                <GradientStop Offset="1" Color="#FF141922" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="SkAxle" GradientOrigin="35%,30%">
                <GradientStop Offset="0" Color="#FFE3E9F4" />
                <GradientStop Offset="0.4" Color="#FF8D99B1" />
                <GradientStop Offset="0.75" Color="#FF586278" />
                <GradientStop Offset="1" Color="#FF2A3242" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="SkRubber" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FF4A5468" />
                <GradientStop Offset="0.3" Color="#FF262D3A" />
                <GradientStop Offset="1" Color="#FF0B0F15" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkGlassBack" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Offset="0" Color="#B305080D" />
                <GradientStop Offset="0.3" Color="#591A2233" />
                <GradientStop Offset="0.7" Color="#4D1A2233" />
                <GradientStop Offset="1" Color="#BF05080D" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkLiquidShade" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#38FFFFFF" />
                <GradientStop Offset="0.12" Color="#00FFFFFF" />
                <GradientStop Offset="0.8" Color="#00000000" />
                <GradientStop Offset="1" Color="#47000000" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="SkFace" GradientOrigin="38%,30%">
                <GradientStop Offset="0" Color="#FF253049" />
                <GradientStop Offset="0.7" Color="#FF141C2B" />
                <GradientStop Offset="1" Color="#FF0B1019" />
            </RadialGradientBrush>
            <SolidColorBrush x:Key="SkEdge" Color="#FF667289" />
            <SolidColorBrush x:Key="SkSlot" Color="#FF0B0F15" />
            <SolidColorBrush x:Key="SkGroove" Color="#B30B0F15" />
            <SolidColorBrush x:Key="SkRecess" Color="#C705080D" />
            <SolidColorBrush x:Key="SkEngrave" Color="#FF8FA4CC" />
            <SolidColorBrush x:Key="SkTick" Color="#FF8794A8" />
            <SolidColorBrush x:Key="SkGlassRim" Color="#47FFFFFF" />
            <SolidColorBrush x:Key="SkGlassInner" Color="#59000000" />
            <SolidColorBrush x:Key="SkTrack" Color="#80000000" />
            <SolidColorBrush x:Key="SkTubeRim" Color="#57FFFFFF" />
            <SolidColorBrush x:Key="SkTubeBg" Color="#B805080D" />
            <SolidColorBrush x:Key="SkTubeCore" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="SkLedOff" Color="#FF3A4558" />
            <BoxShadows x:Key="SkShadow">0 3 6 0 #80000000</BoxShadows>
            <BoxShadows x:Key="SkRaisedShadow">0 4 10 0 #66000000, inset 0 1 0 0 #66FFFFFF</BoxShadows>
            <BoxShadows x:Key="SkDomeShadow">0 2 5 0 #99000000</BoxShadows>
            <BoxShadows x:Key="SkInset">inset 0 2 8 0 #CC000000</BoxShadows>
            <BoxShadows x:Key="SkRailInset">inset 0 1 3 0 #AA000000</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <LinearGradientBrush x:Key="SkBase" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FFFFFFFF" />
                <GradientStop Offset="0.45" Color="#FFD9E0EC" />
                <GradientStop Offset="1" Color="#FFB0BBCE" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkBody" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FFFFFFFF" />
                <GradientStop Offset="0.12" Color="#FFF1F4F9" />
                <GradientStop Offset="0.55" Color="#FFD9E0EC" />
                <GradientStop Offset="1" Color="#FFB0BBCE" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkRodV" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Offset="0" Color="#FF98A4B9" />
                <GradientStop Offset="0.35" Color="#FFFFFFFF" />
                <GradientStop Offset="0.6" Color="#FFCBD3E0" />
                <GradientStop Offset="1" Color="#FF8D99B1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkRodH" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FF98A4B9" />
                <GradientStop Offset="0.28" Color="#FFFFFFFF" />
                <GradientStop Offset="0.62" Color="#FFCBD3E0" />
                <GradientStop Offset="1" Color="#FF8D99B1" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="SkKnob" GradientOrigin="35%,30%">
                <GradientStop Offset="0" Color="#FFDDE4F0" />
                <GradientStop Offset="0.35" Color="#FFB5C0D3" />
                <GradientStop Offset="0.8" Color="#FF8793AB" />
                <GradientStop Offset="1" Color="#FF65718A" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="SkAxle" GradientOrigin="35%,30%">
                <GradientStop Offset="0" Color="#FFFFFFFF" />
                <GradientStop Offset="0.4" Color="#FFE3E9F4" />
                <GradientStop Offset="0.75" Color="#FFB0BBCE" />
                <GradientStop Offset="1" Color="#FF8D99B1" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="SkRubber" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FFB4BED0" />
                <GradientStop Offset="0.3" Color="#FF8F9BB2" />
                <GradientStop Offset="1" Color="#FF5E6A84" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkGlassBack" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Offset="0" Color="#4D6F7F9E" />
                <GradientStop Offset="0.3" Color="#14FFFFFF" />
                <GradientStop Offset="0.7" Color="#10FFFFFF" />
                <GradientStop Offset="1" Color="#4D6F7F9E" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkLiquidShade" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#4DFFFFFF" />
                <GradientStop Offset="0.12" Color="#00FFFFFF" />
                <GradientStop Offset="0.8" Color="#00FFFFFF" />
                <GradientStop Offset="1" Color="#26405070" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="SkFace" GradientOrigin="38%,30%">
                <GradientStop Offset="0" Color="#FFFFFFFF" />
                <GradientStop Offset="0.7" Color="#FFEEF2F8" />
                <GradientStop Offset="1" Color="#FFD3DBE8" />
            </RadialGradientBrush>
            <SolidColorBrush x:Key="SkEdge" Color="#FFA3AEC1" />
            <SolidColorBrush x:Key="SkSlot" Color="#FF3A465C" />
            <SolidColorBrush x:Key="SkGroove" Color="#554A5670" />
            <SolidColorBrush x:Key="SkRecess" Color="#FF5E6A84" />
            <SolidColorBrush x:Key="SkEngrave" Color="#FF5A6580" />
            <SolidColorBrush x:Key="SkTick" Color="#FF7A869C" />
            <SolidColorBrush x:Key="SkGlassRim" Color="#73607090" />
            <SolidColorBrush x:Key="SkGlassInner" Color="#40405070" />
            <SolidColorBrush x:Key="SkTrack" Color="#26405070" />
            <SolidColorBrush x:Key="SkTubeRim" Color="#FF98A4B9" />
            <SolidColorBrush x:Key="SkTubeBg" Color="#FFD3DBE8" />
            <SolidColorBrush x:Key="SkTubeCore" Color="#FFF4F7FB" />
            <SolidColorBrush x:Key="SkLedOff" Color="#FFB0BBCE" />
            <BoxShadows x:Key="SkShadow">0 3 6 0 #3D283250</BoxShadows>
            <BoxShadows x:Key="SkRaisedShadow">0 3 8 0 #33283250, inset 0 1 0 0 #99FFFFFF</BoxShadows>
            <BoxShadows x:Key="SkDomeShadow">0 2 4 0 #4D283250</BoxShadows>
            <BoxShadows x:Key="SkInset">inset 0 1 4 0 #33283250</BoxShadows>
            <BoxShadows x:Key="SkRailInset">inset 0 1 2 0 #33000000</BoxShadows>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Theme independent -->
    <LinearGradientBrush x:Key="SkSheen" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#38FFFFFF" />
        <GradientStop Offset="0.35" Color="#0AFFFFFF" />
        <GradientStop Offset="0.36" Color="#00FFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SkBevel" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#66FFFFFF" />
        <GradientStop Offset="0.12" Color="#00FFFFFF" />
        <GradientStop Offset="0.85" Color="#00000000" />
        <GradientStop Offset="1" Color="#33000000" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SkAccentV" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="{DynamicResource SukiPrimaryColor75}" />
        <GradientStop Offset="0.5" Color="{DynamicResource SukiPrimaryColor}" />
        <GradientStop Offset="1" Color="{DynamicResource SukiPrimaryColor75}" />
    </LinearGradientBrush>
</ResourceDictionary>
